{
    "id": "/shopping-list",
    "name": "Home Pantry",
    "short_name": "Pantry",
    "description": "Your household's catalog, pantry and shopping list, with recipes that stock their own ingredients.",
    "lang": "en",
    "dir": "ltr",
    "start_url": "/shopping-list",
    "scope": "/",
    "display": "standalone",
    "background_color": "#faf9f7",
    "theme_color": "#7c263e",
    "categories": ["food", "lifestyle", "shopping"],
    "prefer_related_applications": false,
    "icons": [
        { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
        { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
        { "src": "/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
        { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
    ],
    "shortcuts": [
        { "name": "Shopping list", "short_name": "List", "url": "/shopping-list", "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
        { "name": "My pantry", "short_name": "Pantry", "url": "/pantry", "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
        { "name": "Discover items", "short_name": "Discover", "url": "/", "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
        { "name": "Import a recipe", "short_name": "Import", "url": "/recipes/import", "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
    ],
    "screenshots": [
        { "src": "/screenshots/wide.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "Discover items: the shared catalog" },
        { "src": "/screenshots/narrow.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "Discover items on a phone" }
    ]
}
